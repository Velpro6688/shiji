{
  "name": "habit-lab",
  "version": "1.0.0",
  "description": "时迹",
  "main": "main.js",
  "productName": "时迹",
  "scripts": {
    "start": "electron .",
    "lint": "eslint main.js preload.js store.js reminders.js startup-decide.js habit-rules.js backup-history.js ui.js js scripts --ext .js,.cjs",
    "electron:install": "node node_modules/electron/install.js",
    "predist": "npm run electron:install",
    "dist": "npm run release:sync && electron-builder --win portable --config.directories.output=artifacts/portable-staging-1.0.0",
    "release:sync": "node scripts/release-sync.cjs",
    "release:prepare": "node scripts/prepare-release.cjs",
    "check": "node scripts/release-sync.cjs --check && node scripts/verify/check-inline-js.cjs habit.html main.js preload.js store.js reminders.js ui.js startup-decide.js habit-rules.js backup-history.js js",
    "verify:all": "npm run check && npm run verify:startup && npm run verify:flush && npm run verify:recovery && npm run verify:core && npm run verify:ui && npm run verify:honesty && npm run verify:interact && npm run verify:chip && npm run verify:r25 && npm run verify:css && npm run verify:layout && npm run verify:security && npm run verify:critical && npm run verify:import && npm run verify:remind && npm run verify:sync && npm run verify:planning && npm run verify:backup-history && npm run verify:v260 && npm run verify:scales && npm run verify:header && npm run verify:insights && npm run verify:v263 && npm run verify:v264 && npm run verify:v265 && npm run verify:window-stability && npm run verify:v266 && npm run verify:v267 && npm run verify:responsive && npm run verify:interaction-edges && npm run verify:memo-editor && npm run verify:v301 && npm run verify:window-boundaries && npm run verify:native-clipboard && npm run verify:v304 && npm run verify:v306 && npm run verify:todo",
    "verify:flush": "node scripts/verify/verify-async-flush.cjs",
    "verify:recovery": "node scripts/verify/verify-data-recovery.cjs",
    "verify:security": "node scripts/verify/run-electron.cjs scripts/verify/verify-security.cjs",
    "verify:core": "node scripts/verify/run-electron.cjs scripts/verify/verify-optimization-core.cjs",
    "verify:ui": "node scripts/verify/run-electron.cjs scripts/verify/verify-ui-workflows.cjs",
    "verify:honesty": "node scripts/verify/run-electron.cjs scripts/verify/verify-v231-honesty.cjs",
    "verify:interact": "node scripts/verify/run-electron.cjs scripts/verify/verify-v231-interact.cjs",
    "verify:chip": "node scripts/verify/run-electron.cjs scripts/verify/verify-chip-jump.cjs",
    "verify:r25": "node scripts/verify/run-electron.cjs scripts/verify/verify-r25-fixes.cjs",
    "verify:css": "node scripts/verify/run-electron.cjs scripts/verify/verify-v231-css.cjs",
    "verify:layout": "node scripts/verify/run-electron.cjs scripts/verify/verify-v231-layout.cjs",
    "verify:startup": "node scripts/verify/verify-startup-decide.cjs",
    "verify:performance": "node scripts/verify/run-electron.cjs scripts/verify/verify-ui-performance.cjs verify-ui-performance-after-result.json after",
    "verify:packed-ui": "node scripts/verify/run-electron.cjs scripts/verify/verify-packed-ui.cjs verify-packed-ui-result.json artifacts/portable-staging-1.0.0/win-unpacked/resources/app.asar",
    "verify:transactions": "node scripts/verify/verify-store-transactions.cjs",
    "verify:quit": "node scripts/verify/verify-real-quit.cjs",
    "verify:audit": "node scripts/verify/run-electron.cjs scripts/verify/verify-audit-workflows.cjs",
    "verify:geometry": "node scripts/verify/run-electron.cjs scripts/verify/verify-ui-geometry.cjs",
    "verify:import": "node scripts/verify/run-electron.cjs scripts/verify/verify-import.cjs",
    "verify:remind": "node scripts/verify/run-electron.cjs scripts/verify/verify-remind.cjs",
    "verify:sync": "node scripts/verify/run-electron.cjs scripts/verify/verify-save-guard.cjs",
    "verify:critical": "npm run verify:transactions && npm run verify:quit && npm run verify:audit && npm run verify:geometry && npm run verify:import-transaction",
    "verify:import-transaction": "node scripts/verify/run-electron.cjs scripts/verify/verify-import-transaction.cjs",
    "verify:planning": "node scripts/verify/verify-planning.cjs",
    "verify:backup-history": "node scripts/verify/verify-backup-history.cjs",
    "verify:v260": "node scripts/verify/run-electron.cjs scripts/verify/verify-v260.cjs",
    "verify:scales": "node scripts/verify/verify-scales.cjs",
    "verify:header": "node scripts/verify/run-electron.cjs scripts/verify/verify-header.cjs",
    "verify:insights": "node scripts/verify/run-electron.cjs scripts/verify/verify-insights.cjs",
    "verify:v263": "node scripts/verify/run-electron.cjs scripts/verify/verify-v263.cjs",
    "verify:v264": "node scripts/verify/run-electron.cjs scripts/verify/verify-v264.cjs",
    "verify:v265": "node scripts/verify/run-electron.cjs scripts/verify/verify-v265.cjs",
    "verify:window-stability": "node scripts/verify/run-electron.cjs scripts/verify/verify-window-stability.cjs",
    "verify:v266": "node scripts/verify/run-electron.cjs scripts/verify/verify-v266.cjs",
    "verify:v267": "node scripts/verify/run-electron.cjs scripts/verify/verify-v267.cjs",
    "verify:responsive": "node scripts/verify/run-electron.cjs scripts/verify/verify-responsive.cjs",
    "verify:interaction-edges": "node scripts/verify/run-electron.cjs scripts/verify/verify-interaction-edges.cjs",
    "verify:memo-editor": "node scripts/verify/run-electron.cjs scripts/verify/verify-memo-editor.cjs",
    "verify:v301": "node scripts/verify/run-electron.cjs scripts/verify/verify-v301.cjs",
    "verify:window-boundaries": "node scripts/verify/verify-window-boundaries.cjs",
    "verify:native-clipboard": "node scripts/verify/run-electron.cjs scripts/verify/verify-native-clipboard.cjs",
    "verify:installer-lifecycle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify/verify-installer-lifecycle.ps1",
    "verify:v304": "node scripts/verify/run-electron.cjs scripts/verify/verify-v304.cjs",
    "verify:v306": "node scripts/verify/run-electron.cjs scripts/verify/verify-v306.cjs",
    "verify:todo": "node scripts/verify/run-electron.cjs scripts/verify/verify-todo.cjs",
    "verify:v313": "node scripts/verify/run-electron.cjs scripts/verify/verify-v313.cjs",
    "verify:corners": "node scripts/verify/run-electron.cjs scripts/verify/verify-continuous-corners.cjs",
    "verify:onboarding": "node scripts/verify/run-electron.cjs scripts/verify/verify-onboarding.cjs",
    "preverify:all": "npm run electron:install",
    "dist:mac": "npm run electron:install && electron-builder --mac zip --publish never --config.directories.output=artifacts/mac-build"
  },
  "build": {
    "appId": "com.habitlab.desktop",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "reminders.js",
      "startup-decide.js",
      "habit.html",
      "ui.js",
      "js/**/*",
      "styles/**/*",
      "logo.ico",
      "logo-32.png",
      "locales/**/*",
      "habit-rules.js",
      "backup-history.js"
    ],
    "extraResources": [],
    "win": {
      "icon": "logo.ico",
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "extraResources": [
        "desktop-layer.exe"
      ]
    },
    "portable": {
      "artifactName": "时迹-便携版-1.0.0.exe"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "logo.icns"
    }
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "eslint": "^8.57.1"
  },
  "releaseDate": "2026-11-07",
  "license": "MIT",
  "author": "Velpro"
}
